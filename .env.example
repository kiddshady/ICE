# Copiá este archivo como .env y completalo. El .env no se sube al repo.

# El token que te da @BotFather al crear el bot.
ICE_TOKEN=

# Opcional: el id de un chat donde ICE avisa cada vez que se conecta. Para
# saber el id de tu chat privado, mandale /start al bot: te lo contesta.
ICE_NOTIFY_CHAT=
